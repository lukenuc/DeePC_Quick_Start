
clear all; 
close all; 
rng(0); 

%% System Dynamics

m = 1; p = 1;  
Ts = 0.1; 
b = 0.0; % drag coefficient
A = [0 1; 0 -b];
B = [0; 1];
C = eye(2);
D = [0; 0];

% discrete time dynamics
Ad = eye(2) + Ts.*A;
Bd = Ts.*B;

%% Generate persistently exciting trajectory

tf = 100;
N = tf/Ts + 1;        % number of samples in trajectory
L = 10;         % prediction horizon (referred to as "lag" in Willems' paper)
n = 2;          % state cardinality (how many states are in the system)
walk = cumsum(rand(1,N) - 0.5);
% walk = rand(1,N) - 0.5; 
inp = @(t_in) walk(t_in);
dynamics = @(x,u) Ad*x + Bd*u; 
x = [0; 0];     % initial state
t = linspace(0, tf, N);
u_arr = zeros(1, N); 
x_arr = zeros(2, N); 

% get trajectories and plot
for i = 1:N
    x = dynamics(x, inp(i)); 
    x_arr(:,i) = x; 
    u_arr(:,i) = inp(i); 
end

plot(t, x_arr(2,:))
hold on 
plot(t, u_arr)
hold off
legend('x', 'u')

% generate Hankel matrices
Hy = zeros(p*(L+n), N-L-1); Hu = zeros(m*(L+n), N-L-1); 
for i = 1:N-L-1
    u_t = u_arr(:,i:i+m*(L+n)-1); y_t = x_arr(:,i:i+p*(L+n)-1);
    Hu(:,i) = u_t(:); 
    Hy(:,i) = (y_t(2,:))';
end

